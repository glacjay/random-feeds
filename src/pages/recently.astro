---
import Layout from '@/layouts/Layout.astro';
import { getToken, loginRedirectUrl } from '@/lib/auth';
import { loadRecentlyReadItems } from '@/lib/data';
import type { Item as ItemType } from '@/lib/types';
import Item from '@/components/Item.astro';
import UpstreamError from '@/components/UpstreamError.astro';

// 1. Get token and context
const token = getToken(Astro.cookies);
if (!token) {
    return Astro.redirect(loginRedirectUrl(Astro.url));
}

// 2. Fetch data; degrade gracefully if BazQux is down.
let items: ItemType[] = [];
let upstreamError: string | undefined;
try {
    items = await loadRecentlyReadItems(Astro, token);
} catch (error) {
    console.error('Failed to load recently read items:', error);
    upstreamError = error instanceof Error ? error.message : String(error);
}
---

<Layout title="Recently Read">
    <div class="py-4">
        {upstreamError && (
            <div class="mb-4">
                <UpstreamError detail={upstreamError} />
            </div>
        )}
        <h1 class="text-2xl font-bold mb-4">Recently Read Items ({items.length})</h1>
        <div class="flex flex-col">
            {items.length > 0 ? (
                items.map(item => <Item item={item} />)
            ) : (
                <p class="text-center text-gray-500 mt-8">No recently read items found.</p>
            )}
        </div>
    </div>
</Layout>
