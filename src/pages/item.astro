---
import Layout from '@/layouts/Layout.astro';
import { getToken } from '@/lib/auth';
import { loadItem, loadFeedUnreadsCount } from '@/lib/data';
import type { Item } from '@/lib/types';
import { ItemActions } from '@/components/ItemActions';
import dayjs from 'dayjs';

// 1. Get token and IDs
const token = getToken(Astro.cookies);
if (!token) {
    return Astro.redirect('/login');
}
const itemId = Astro.url.searchParams.get('id');
const folderId = Astro.url.searchParams.get('folderId') || undefined;

if (!itemId) {
    return new Response('Item ID is required', { status: 400 });
}

// 2. Fetch data
const item: Item = await loadItem(token, { id: itemId });
const unreadCount = await loadFeedUnreadsCount(token, item?.origin?.streamId);

const articleHtml = item?.summary?.content || '';

const iframeContent = `<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark" />
  <style>
    body {
      font-family: system-ui, -apple-system, sans-serif;
      line-height: 1.6;
      margin: 0;
      padding: 24px 12px;
    }
    img, video, svg { max-width: 100%; height: auto; }
    pre { overflow-x: auto; }
    table { max-width: 100%; }
  </style>
</head>
<body>${articleHtml}</body>
</html>`;
---

<Layout title={item?.title || 'Item'} contentClass="p-0">
    <div class="flex flex-col min-h-screen">
        {/* Sticky Header */}
        <header class="sticky top-0 bg-gray-200 dark:bg-gray-800 p-4 shadow-md z-10">
            <a href={item?.canonical?.[0]?.href} target="_blank" rel="noopener noreferrer">
                <h1 class="text-xl font-bold break-words">{item?.title}</h1>
                <div class="flex justify-between items-center mt-2 text-xs text-gray-600 dark:text-gray-400">
                    <span>({unreadCount}) {item?.origin?.title} | {item?.author}</span>
                    <span>{dayjs(item?.updated * 1000).format('YYYY-MM-DD HH:mm')}</span>
                </div>
            </a>
        </header>

        {/* Article Content — iframe isolates RSS HTML from Tailwind Preflight */}
        <iframe id="article-frame" srcdoc={iframeContent} class="w-full border-none" />

        {/* Spacer for the fixed footer */}
        <div class="flex-grow"></div>
        <div class="h-28"></div>

        {/* Fixed Footer Actions */}
        <footer class="fixed bottom-0 left-0 right-0 z-10 border-t bg-background/95 backdrop-blur-sm">
            <div class="max-w-3xl mx-auto flex">
                 <ItemActions folderId={folderId} item={item} client:load />
            </div>
        </footer>
    </div>
</Layout>

<script is:inline>
  (function() {
    var frame = document.getElementById('article-frame');
    if (!frame) return;

    function resize() {
      try {
        var doc = frame.contentDocument || frame.contentWindow?.document;
        if (!doc) return;
        frame.style.height = doc.documentElement.scrollHeight + 'px';
      } catch (e) {
        // cross-origin restriction — shouldn't happen with srcdoc
      }
    }

    frame.addEventListener('load', function() {
      resize();
      // Some content loads late (images, iframes, etc.)
      var observer = new MutationObserver(resize);
      try {
        observer.observe(frame.contentDocument.body, {
          childList: true,
          subtree: true,
          attributes: true
        });
      } catch (e) {}
    });
  })();
</script>
